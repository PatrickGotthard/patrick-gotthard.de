  <body class="bg-slate-50 text-slate-800">
    <Section>
      <h1 class="animate-fade-in-up animate-delay-100 font-heading text-5xl font-bold tracking-tight sm:text-6xl md:text-7xl">Patrick Gotthard</h1>
      <h2 class="animate-fade-in-up animate-delay-200 font-heading font-medum mt-4 text-2xl sm:text-3xl">Softwareentwickler</h2>
    </Section>

    <Divider />

    <Section>
      <h1>Impressum</h1>

      <h2>Angaben gemäß § 5 DDG</h2>
      <p>
        Patrick Gotthard<br />
        Wespenweg 6<br />
        24145 Kiel<br />
        Deutschland
      </p>

      <h2>Kontakt</h2>
      <p>
        E-Mail: <a href="mailto:mail@patrick-gotthard.de">mailto:mail@patrick-gotthard.de</a>
