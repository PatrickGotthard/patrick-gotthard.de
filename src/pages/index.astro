---
import Skill from "../components/Skill.astro";
import SkillBox from "../components/SkillBox.astro";
import ContactButton from "../components/ContactButton.astro";
import ExternalLink from "../components/ExternalLink.astro";
import SectionTitle from "../components/SectionTitle.astro";
import TimelineEntry from "../components/TimelineEntry.astro";
import "../styles/global.css";
---

<html lang="de" class="scroll-smooth">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <title>Astro</title><link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@500;600;700;800&family=Source+Sans+3:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <script src="https://unpkg.com/lucide@latest"></script>
  </head>
  <body
    class="min-h-screen overflow-x-hidden bg-slate-50 font-['Source_Sans_3',sans-serif] text-slate-900 [&_*:focus-visible]:outline-3 [&_*:focus-visible]:outline-offset-3 [&_*:focus-visible]:outline-[#6f9bc9] [&_h1]:font-['Outfit',sans-serif] [&_h2]:font-['Outfit',sans-serif] [&_h3]:font-['Outfit',sans-serif]"
  >
    <main class="mx-auto flex min-h-screen max-w-3xl flex-col justify-center px-6 py-20">
      <!-- Intro -->
      <section
        class="relative order-1 pb-16 after:absolute after:right-[calc(50%-50vw)] after:bottom-0 after:left-[calc(50%-50vw)] after:h-px after:bg-slate-200"
      >
        <nav class="flex flex-wrap gap-x-6 gap-y-2 text-sm font-semibold text-slate-500" aria-label="Seitennavigation">
          <a class="transition hover:text-blue-600" href="#skills">Skills</a>
          <a class="transition hover:text-blue-600" href="#laufbahn">Laufbahn</a>
          <a class="transition hover:text-blue-600" href="#kontakt">Kontakt</a>
        </nav>

        <h1 class="mt-12 text-5xl font-bold tracking-tight sm:text-6xl md:text-7xl">Patrick Gotthard</h1>

        <h2 class="mt-4 text-2xl font-semibold text-slate-500 sm:text-3xl">
          Softwareentwickler<span class="text-[#6f9bc9]">.</span>
        </h2>

        <p class="mt-8 max-w-2xl text-lg leading-8 text-slate-600">
          Moin moin! Ich heiße Patrick Gotthard und wurde am 20. Mai 1988 in Kiel geboren. Seit Mitte der 90er beschäftige ich mich mit Computern, angefangen
          mit MS-DOS 6.0, und habe mir im Laufe der Jahre ein umfangreiches Wissen in dem Bereich angeeignet. Mittlerweile liegt mein Schwerpunkt bei der
          Softwareentwicklung.
        </p>
      </section>

      <!-- Skills -->
      <section
        id="skills"
        class="relative order-3 py-16 after:absolute after:right-[calc(50%-50vw)] after:bottom-0 after:left-[calc(50%-50vw)] after:h-px after:bg-slate-200 [&_.skill-badge]:cursor-pointer [&_.skill-badge]:bg-[#e2edf8]! [&_.skill-badge]:text-slate-700! [&_.skill-badge]:no-underline [&_.skill-badge]:transition [&_.skill-badge]:duration-150 [&_.skill-badge:hover]:-translate-y-px [&_.skill-badge:hover]:bg-[#d1e3f4]! [&_.skill-badge:hover]:text-slate-700! [&_.skill-icon]:h-4 [&_.skill-icon]:w-4 [&_.skill-icon]:object-contain [&>div>div]:transition [&>div>div]:duration-200 [&>div>div]:ease-out [&>div>div:hover]:-translate-y-1 [&>div>div:hover]:shadow-[0_12px_28px_rgb(15_23_42/0.1)]"
      >
        <SectionTitle title="Skills" />

        <div class="mt-6 space-y-5">
          <!-- Sprachen -->
          <SkillBox title="Sprachen">
            <Skill icon="https://cdn.jsdelivr.net/gh/devicons/devicon/icons/java/java-original.svg">Java</Skill>
            <Skill icon="https://cdn.jsdelivr.net/gh/devicons/devicon/icons/typescript/typescript-original.svg">TypeScript</Skill>
            <Skill icon="https://cdn.jsdelivr.net/gh/devicons/devicon/icons/javascript/javascript-original.svg">JavaScript</Skill>
            <Skill icon="https://cdn.jsdelivr.net/gh/devicons/devicon/icons/python/python-original.svg">Python</Skill>
            <Skill icon="https://cdn.jsdelivr.net/gh/devicons/devicon/icons/php/php-original.svg">PHP</Skill>
            <Skill icon="https://cdn.jsdelivr.net/gh/devicons/devicon/icons/html5/html5-original.svg">HTML</Skill>
            <Skill icon="https://cdn.jsdelivr.net/gh/devicons/devicon/icons/css3/css3-original.svg">CSS</Skill>
          </SkillBox>

          <!-- Technologien -->
          <SkillBox title="Technologien">
            <Skill icon="https://cdn.jsdelivr.net/gh/devicons/devicon/icons/spring/spring-original.svg">Spring</Skill>
            <Skill icon="https://cdn.jsdelivr.net/gh/devicons/devicon/icons/tailwindcss/tailwindcss-original.svg">Tailwind CSS</Skill>
            <Skill icon="https://cdn.simpleicons.org/svelte">Svelte</Skill>
            <Skill icon="https://cdn.jsdelivr.net/gh/devicons/devicon/icons/vuejs/vuejs-original.svg">Vue.js</Skill>
            <Skill icon="https://cdn.jsdelivr.net/gh/devicons/devicon/icons/nodejs/nodejs-original.svg">Node.js</Skill>
            <Skill icon="https://cdn.jsdelivr.net/gh/devicons/devicon/icons/maven/maven-original.svg">Maven</Skill>
            <Skill icon="https://cdn.jsdelivr.net/gh/devicons/devicon/icons/git/git-original.svg">Git</Skill>
            <Skill icon="https://api.iconify.design/simple-icons:springboot.svg">Spring Boot</Skill>
            <Skill icon="https://cdn.simpleicons.org/thymeleaf">Thymeleaf</Skill>
            <Skill icon="https://cdn.jsdelivr.net/gh/devicons/devicon/icons/docker/docker-original.svg">Docker</Skill>
          </SkillBox>

          <!-- Datenbanken -->
          <SkillBox title="Datenbanken">
            <Skill icon="https://cdn.jsdelivr.net/gh/devicons/devicon/icons/mysql/mysql-original.svg">MySQL</Skill>
            <Skill icon="https://cdn.jsdelivr.net/gh/devicons/devicon/icons/mariadb/mariadb-original.svg">MariaDB</Skill>
            <Skill icon="https://cdn.jsdelivr.net/gh/devicons/devicon/icons/postgresql/postgresql-original.svg">PostgreSQL</Skill>
            <Skill icon="https://cdn.jsdelivr.net/gh/devicons/devicon/icons/mongodb/mongodb-original.svg">MongoDB</Skill>
          </SkillBox>

          <!-- AWS -->
          <SkillBox title="AWS">
            <Skill icon="https://cdn.simpleicons.org/serverless">Serverless Framework</Skill>
            <Skill icon="https://api.iconify.design/simple-icons:amazonaws.svg">CDK</Skill>
            <Skill icon="https://api.iconify.design/logos:aws-ecs.svg">ECS</Skill>
            <Skill icon="https://api.iconify.design/logos:aws-sns.svg">SNS</Skill>
            <Skill icon="https://api.iconify.design/logos:aws-sqs.svg">SQS</Skill>
            <Skill icon="https://api.iconify.design/logos:aws-cloudformation.svg">CloudFormation</Skill>
            <Skill icon="https://api.iconify.design/logos:aws-cloudwatch.svg">CloudWatch</Skill>
            <Skill icon="https://api.iconify.design/logos:aws-lambda.svg">Lambda</Skill>
            <Skill icon="https://api.iconify.design/logos:aws-iam.svg">IAM</Skill>
            <Skill icon="https://api.iconify.design/logos:aws-s3.svg">S3</Skill>
          </SkillBox>

          <!-- GCP -->
          <SkillBox title="GCP">
            <Skill icon="https://cdn.jsdelivr.net/gh/devicons/devicon/icons/googlecloud/googlecloud-original.svg">GCP</Skill>
            <Skill icon="https://cdn.jsdelivr.net/gh/devicons/devicon/icons/terraform/terraform-original.svg">Terraform</Skill>
          </SkillBox>

          <!-- Kubernetes -->
          <SkillBox title="Kubernetes">
            <Skill icon="https://cdn.jsdelivr.net/gh/devicons/devicon/icons/kubernetes/kubernetes-original.svg">Kubernetes</Skill>
          </SkillBox>

          <!-- Tools -->
          <SkillBox title="Tools">
            <Skill icon="https://cdn.jsdelivr.net/gh/devicons/devicon/icons/spring/spring-original.svg">Spring Tool Suite</Skill>
            <Skill icon="https://cdn.jsdelivr.net/gh/devicons/devicon/icons/vscode/vscode-original.svg">VSCode</Skill>
            <Skill icon="https://cdn.simpleicons.org/postman">Postman</Skill>
            <Skill icon="https://cdn.simpleicons.org/apachejmeter">Apache JMeter</Skill>
            <Skill icon="https://cdn.jsdelivr.net/gh/devicons/devicon/icons/chrome/chrome-original.svg">Google Chrome</Skill>
            <Skill icon="https://www.heidisql.com/favicon.ico">HeidiSQL</Skill>
            <Skill icon="https://cdn.simpleicons.org/notepadplusplus">Notepad++</Skill>
            <Skill icon="https://api.iconify.design/devicon:putty.svg">PuTTY</Skill>
            <Skill icon="https://cdn.simpleicons.org/mongodb">Studio 3T</Skill>
            <Skill icon="https://cdn.simpleicons.org/datagrip">DataGrip</Skill>
            <Skill icon="https://winscp.net/favicon.ico">WinSCP</Skill>
          </SkillBox>

          <!-- Betriebssysteme -->
          <SkillBox title="Betriebssysteme">
            <Skill icon="https://cdn.jsdelivr.net/gh/devicons/devicon/icons/windows8/windows8-original.svg">Windows</Skill>
            <Skill icon="https://cdn.jsdelivr.net/gh/devicons/devicon/icons/linux/linux-original.svg">Linux</Skill>
            <Skill icon="https://cdn.jsdelivr.net/gh/devicons/devicon/icons/apple/apple-original.svg">macOS</Skill>
          </SkillBox>

          <!-- Sonstiges -->
          <SkillBox title="Sonstiges">
            <Skill icon="https://cdn.jsdelivr.net/gh/devicons/devicon/icons/fastapi/fastapi-original.svg">REST</Skill>
            <Skill icon="https://cdn.jsdelivr.net/gh/devicons/devicon/icons/sonarqube/sonarqube-original.svg">Clean Code</Skill>
            <Skill icon="https://cdn.jsdelivr.net/gh/devicons/devicon/icons/git/git-original.svg">Git</Skill>
          </SkillBox>
        </div>
      </section>

      <!-- Laufbahn -->
      <section
        id="laufbahn"
        class="relative order-4 py-16 after:absolute after:right-[calc(50%-50vw)] after:bottom-0 after:left-[calc(50%-50vw)] after:h-px after:bg-slate-200 [&_a]:text-inherit [&_a]:underline [&_a]:decoration-slate-400 [&_a]:decoration-1 [&_a]:underline-offset-2 [&_a]:transition-colors [&_a:hover]:text-blue-600"
      >
        <SectionTitle title="Laufbahn" />

        <div
          class="relative mt-8 space-y-8 before:absolute before:top-2 before:bottom-2 before:left-2 before:w-px before:bg-slate-300 sm:before:left-40 [&>.timeline-entry]:relative [&>.timeline-entry]:pl-8 [&>.timeline-entry]:before:absolute [&>.timeline-entry]:before:top-[0.35rem] [&>.timeline-entry]:before:left-[0.2rem] [&>.timeline-entry]:before:h-[0.65rem] [&>.timeline-entry]:before:w-[0.65rem] [&>.timeline-entry]:before:rounded-full [&>.timeline-entry]:before:border-2 [&>.timeline-entry]:before:border-[#6f9bc9] [&>.timeline-entry]:before:bg-slate-50 sm:[&>.timeline-entry]:grid sm:[&>.timeline-entry]:grid-cols-[9rem_1fr] sm:[&>.timeline-entry]:gap-8 sm:[&>.timeline-entry]:pl-0 sm:[&>.timeline-entry]:before:left-[9.7rem]"
        >
          <TimelineEntry date="09/1994 - 07/1998">
            <ExternalLink href="https://grundschuledaenischenhagen.de/"> Grundschule Dänischenhagen </ExternalLink>
          </TimelineEntry>

          <TimelineEntry date="09/1998 - 06/2004">
            <ExternalLink href="https://www.gemeinschaftsschule-altenholz.de/">Realschule Altenholz</ExternalLink>
          </TimelineEntry>

          <TimelineEntry date="08/2004 - 06/2007">
            <ExternalLink href="https://rbz-technik-kiel.geo.io/"> Berufliches Gymnasium Fachrichtung Technik </ExternalLink>
          </TimelineEntry>

          <TimelineEntry date="08/2007 - 04/2008">
            Zivildienst beim
            <ExternalLink href="https://www.paritaet-sh.org/">Paritätischen SH</ExternalLink>
          </TimelineEntry>

          <TimelineEntry date="05/2008 - 09/2008">
            Praktikum bei der
            <ExternalLink href="https://www.consist.de/"> Consist Software Solutions GmbH </ExternalLink>
          </TimelineEntry>

          <TimelineEntry date="10/2008 - 09/2011">
            Duales Studium zum B.Sc. (Wirtschaftsinformatik) an der
            <ExternalLink href="https://www.wak-sh.de/"> Wirtschaftsakademie Schleswig-Holstein </ExternalLink>
            in Kooperation mit der
            <ExternalLink href="https://www.consist.de/"> Consist Software Solutions GmbH </ExternalLink>
          </TimelineEntry>

          <TimelineEntry date="10/2011 - 03/2014">
            Softwareentwickler bei der
            <ExternalLink href="https://www.askdante.com/ueber-uns"> Bader&amp;Jene Software-Ingenieurbüro GmbH </ExternalLink>
          </TimelineEntry>

          <TimelineEntry date="04/2014 - heute" current>
            Softwareentwickler bei der
            <ExternalLink href="https://www.freenet-mobilfunk.de/">freenet DLS GmbH</ExternalLink>
          </TimelineEntry>
        </div>
      </section>

      <!-- Kontakt -->
      <section
        id="kontakt"
        class="order-5 pt-16 [&_a]:shadow-[0_10px_22px_rgb(15_23_42/0.16)] [&_a]:transition [&_a]:duration-200 [&_a]:ease-out [&_a:hover]:-translate-y-1 [&_a:hover]:bg-[#6f9bc9] [&_a:hover]:shadow-[0_18px_34px_rgb(15_23_42/0.22)]"
      >
        <SectionTitle title="Kontakt" />

        <div class="mt-6 flex flex-col gap-3 sm:flex-row">
          <ContactButton href="https://github.com/PatrickGotthard" label="GitHub" external>
            <img slot="icon" class="h-5 w-5" src="/icons/github.svg" alt="" />
          </ContactButton>
          <ContactButton href="https://www.xing.com/profile/Patrick_Gotthard" label="XING" external>
            <img slot="icon" class="h-5 w-5" src="/icons/xing.svg" alt="" />
          </ContactButton>
          <ContactButton href="mailto:kontakt@patrick-gotthard.de" label="E-Mail">
            <img slot="icon" class="h-5 w-5" src="/icons/mail.svg" alt="" />
          </ContactButton>
        </div>
      </section>

      <!-- Footer -->
      <footer class="order-6 mt-16 text-sm text-slate-400">
        © <span id="year"></span> Patrick Gotthard
      </footer>
    </main>

    <button
      id="scroll-to-top"
      type="button"
      class="pointer-events-none fixed right-6 bottom-6 z-50 flex h-12 w-12 translate-y-4 items-center justify-center rounded-full bg-slate-900 text-white opacity-0 shadow-lg transition-all duration-200 hover:-translate-y-1 hover:bg-blue-600"
      aria-label="Zum Seitenanfang"
      aria-hidden="true"
      title="Zum Seitenanfang"
    >
      <i data-lucide="arrow-up" class="h-5 w-5" aria-hidden="true"></i>
    </button>

    <script>
      document.getElementById("year").textContent = new Date().getFullYear();

      const scrollToTopButton = document.getElementById("scroll-to-top");

      const updateScrollToTopButton = () => {
        const isVisible = window.scrollY > 400;
        scrollToTopButton.classList.toggle("pointer-events-none", !isVisible);
        scrollToTopButton.classList.toggle("translate-y-4", !isVisible);
        scrollToTopButton.classList.toggle("opacity-0", !isVisible);
        scrollToTopButton.setAttribute("aria-hidden", String(!isVisible));
      };

      scrollToTopButton.addEventListener("click", () => {
        window.scrollTo({ top: 0, behavior: "smooth" });
      });
      window.addEventListener("scroll", updateScrollToTopButton, {
        passive: true
      });

      updateScrollToTopButton();
      lucide.createIcons();
    </script>
  </body>
</html>
