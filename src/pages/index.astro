        <Skill icon="devicon:datagrip" href="https://www.jetbrains.com/datagrip">DataGrip</Skill>
        <Skill icon="devicon:docker" href="https://www.docker.com">Docker</Skill>
        <Skill icon="selfhst:draw-io" href="https://www.drawio.com">draw.io</Skill>
        <Skill icon="devicon:eclipse" href="https://eclipseide.org">Eclipse</Skill>
