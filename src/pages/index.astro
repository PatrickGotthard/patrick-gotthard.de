---
import "../styles/global.css";

import ContactButton from "../components/ContactButton.astro";
import Divider from "../components/Divider.astro";
import Link from "../components/Link.astro";
import Section from "../components/Section.astro";
import Skill from "../components/Skill.astro";
import SkillBox from "../components/SkillBox.astro";
import TimelineEntry from "../components/TimelineEntry.astro";
import Timeline from "../components/Timeline.astro";
---

<html lang="de" class="scroll-smooth">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <title>Patrick Gotthard - Softwareentwickler</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
  </head>
  <body class="bg-slate-50 text-slate-800">
    <Section>
      <h1 class="animate-fade-in-up animate-delay-100 font-heading text-5xl font-bold tracking-tight sm:text-6xl md:text-7xl">Patrick Gotthard</h1>
      <h2 class="animate-fade-in-up animate-delay-200 font-heading font-medum mt-4 text-2xl sm:text-3xl">Softwareentwickler</h2>
      <p class="animate-fade-in-up animate-delay-300 mt-8 leading-8">
        Moin moin! Ich bin Patrick, wurde am 20. Mai 1988 in Kiel geboren und beschäftige mich schon seit Mitte der 90er mit Computern. Im Laufe der Jahre habe
        ich mir ein umfangreiches Wissen rund um Betriebssysteme, Netzwerke und Programmierung angeeignet. Mittlerweile habe ich mich auf die
        Softwareentwicklung mit Java und TypeScript sowie Webtechnologien in der Cloud spezialisiert.
      </p>
    </Section>

    <Divider />

    <Section title="Skills">
      <SkillBox title="Sprachen">
        <Skill icon="devicon:java" href="https://www.java.com">Java</Skill>
        <Skill icon="devicon:typescript" href="https://www.typescriptlang.org">TypeScript</Skill>
        <Skill icon="devicon:javascript" href="https://developer.mozilla.org/de/docs/Web/JavaScript">JavaScript</Skill>
        <Skill icon="devicon:python" href="https://www.python.org">Python</Skill>
        <Skill icon="devicon:bash" href="https://www.gnu.org/software/bash">Bash</Skill>
        <Skill icon="devicon:html5" href="https://developer.mozilla.org/de/docs/Web/HTML">HTML</Skill>
        <Skill icon="devicon:css3" href="https://www.w3.org/Style/CSS/Overview.de.html">CSS</Skill>
      </SkillBox>

      <SkillBox title="Frameworks">
        <Skill icon="devicon:spring" href="https://spring.io">Spring</Skill>
        <Skill icon="thesvg-color:spring-boot" href="https://spring.io/projects/spring-boot">Spring Boot</Skill>
        <Skill icon="devicon:nodejs" href="https://nodejs.org">Node.js</Skill>
        <Skill icon="logos:sencha" href="https://www.sencha.com/products/extjs">Ext JS</Skill>
        <Skill icon="devicon:svelte" href="https://svelte.dev">Svelte</Skill>
        <Skill icon="devicon:vuejs" href="https://vuejs.org">Vue.js</Skill>
        <Skill icon="devicon:tailwindcss" href="https://tailwindcss.com">Tailwind CSS</Skill>
      </SkillBox>

      <SkillBox title="Build-Tools">
        <Skill icon="devicon:maven" href="https://maven.apache.org">Maven</Skill>
        <Skill icon="devicon:npm" href="https://www.npmjs.com">npm</Skill>
      </SkillBox>

      <SkillBox title="Datenbanken">
        <Skill icon="devicon:mariadb" href="https://mariadb.org">MariaDB</Skill>
        <Skill icon="devicon:mongodb" href="https://www.mongodb.com">MongoDB</Skill>
        <Skill icon="devicon:mysql" href="https://www.mysql.com">MySQL</Skill>
        <Skill icon="devicon:postgresql" href="https://www.postgresql.org">PostgreSQL</Skill>
      </SkillBox>

      <SkillBox title="AWS">
        <Skill icon="logos:aws-api-gateway" href="https://aws.amazon.com/api-gateway">API Gateway</Skill>
