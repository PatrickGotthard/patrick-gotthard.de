          </TimelineEntry>

          <TimelineEntry date="08/2004 - 06/2007">
            <a href="https://rbz-technik-kiel.geo.io/" target="_blank" rel="noopener noreferrer" class="transition hover:text-blue-600">
              Berufliches Gymnasium Fachrichtung Technik
            </a>
          </TimelineEntry>

          <TimelineEntry date="08/2007 - 04/2008">
            Zivildienst beim
            <a href="https://www.paritaet-sh.org/" target="_blank" rel="noopener noreferrer" class="transition hover:text-blue-600">Paritätischen SH</a>
          </TimelineEntry>

          <TimelineEntry date="05/2008 - 09/2008">
            Praktikum bei der
            <a href="https://www.consist.de/" target="_blank" rel="noopener noreferrer" class="transition hover:text-blue-600">
              Consist Software Solutions GmbH
            </a>
          </TimelineEntry>

          <TimelineEntry date="10/2008 - 09/2011">
            Duales Studium zum B.Sc. (Wirtschaftsinformatik) an der
            <a href="https://www.wak-sh.de/" target="_blank" rel="noopener noreferrer" class="transition hover:text-blue-600">
              Wirtschaftsakademie Schleswig-Holstein
            </a>
            in Kooperation mit der
            <a href="https://www.consist.de/" target="_blank" rel="noopener noreferrer" class="transition hover:text-blue-600">
              Consist Software Solutions GmbH
            </a>
          </TimelineEntry>

          <TimelineEntry date="10/2011 - 03/2014">
            Softwareentwickler bei der
            <a href="https://www.askdante.com/ueber-uns" target="_blank" rel="noopener noreferrer" class="transition hover:text-blue-600">
              Bader&amp;Jene Software-Ingenieurbüro GmbH
            </a>
          </TimelineEntry>

          <TimelineEntry date="04/2014 - heute" current>
            Softwareentwickler bei der
            <a href="https://www.freenet-mobilfunk.de/" target="_blank" rel="noopener noreferrer" class="transition hover:text-blue-600">freenet DLS GmbH</a>
          </TimelineEntry>
