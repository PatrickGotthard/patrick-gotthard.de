        <Skill icon="gcp:cloud-run" href="https://cloud.google.com/run">Cloud Run</Skill>
        <Skill icon="gcp:cloud-tasks" href="https://cloud.google.com/tasks">Cloud Tasks</Skill>
        <Skill icon="gcp:pubsub" href="https://cloud.google.com/pubsub">Pub/Sub</Skill>
        <Skill icon="gcp:security" href="https://cloud.google.com/iam">IAM</Skill>
        <Skill icon="gcp:secret-manager" href="https://cloud.google.com/secret-manager">Secret Manager</Skill>
        <Skill icon="devicon:terraform" href="https://developer.hashicorp.com/terraform">Terraform</Skill>
      </SkillBox>

      <SkillBox title="CI/CD">
        <Skill icon="devicon:bamboo" href="https://www.atlassian.com/de/software/bamboo">Bamboo</Skill>
        <Skill icon="devicon:githubactions" href="https://github.com/features/actions">GitHub Actions</Skill>
        <Skill icon="devicon:jenkins" href="https://www.jenkins.io">Jenkins</Skill>
