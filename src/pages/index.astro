        <Skill icon="logos:aws-cloudfront" hr ef="https://aws.amazon.com/cloudfront">CloudFront</Skill>
        <Skill icon="logos:aws-cloudwatch" href="https://aws.amazon.com/cloudwatch">CloudWatch</Skill>
        <Skill icon="logos:aws-ecs" href="https://aws.amazon.com/ecs">ECS</Skill>
        <Skill icon="logos:aws-iam" href="https://aws.amazon.com/iam">IAM</Skill>
        <Skill icon="logos:aws-lambda" href="https://aws.amazon.com/lambda">Lambda</Skill>
        <Skill icon="logos:aws-s3" href="https://aws.amazon.com/s3">S3</Skill>
        <Skill icon="logos:aws-sns" href="https://aws.amazon.com/sns">SNS</Skill>
        <Skill icon="logos:aws-sqs" href="https://aws.amazon.com/sqs">SQS</Skill>
        <Skill icon="logos:aws-systems-manager" href="https://aws.amazon.com/systems-manager">Systems Manager</Skill>
        <Skill icon="aws-cdk" href="https://aws.amazon.com/cdk">CDK</Skill>
        <Skill icon="logos:serverless" href="https://www.serverless.com">Serverless Framework</Skill>
      </SkillBox>

      <SkillBox title="GCP">
