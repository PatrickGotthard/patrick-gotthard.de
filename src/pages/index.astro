        <Skill icon="thesvg-color:teamspeak" href="https://www.teamspeak.com">Teamspeak</Skill>
        <Skill icon="thesvg-color:traefik" href="https://traefik.io/traefik">Traefik Proxy</Skill>
        <Skill icon="selfhst:truenas-scale" href="https://www.truenas.com">TrueNAS</Skill>
        <Skill icon="selfhst:tvheadend" href="https://tvheadend.org">TvHeadend</Skill>
        <Skill icon="selfhst:unbound" href="https://nlnetlabs.nl/projects/unbound/about">Unbound</Skill>
        <Skill icon="selfhst:ubiquiti-unifi" href="https://ui.com">Unifi</Skill>
        <Skill icon="thesvg-color:vaultwarden" href="https://github.com/dani-garcia/vaultwarden">Vaultwarden</Skill>
      </SkillBox>

      <SkillBox title="Smarthome">
        <Skill icon="selfhst:evcc" href="https://evcc.io">EVCC</Skill>
        <Skill icon="thesvg-color:home-assistant" href="https://www.home-assistant.io">Home Assistant</Skill>
        <Skill icon="thesvg-color:eclipse-mosquitto" href="https://mosquitto.org">Mosquitto</Skill>
        <Skill icon="thesvg-color:zigbee2mqtt" href="https://www.zigbee2mqtt.io">Zigbee2MQTT</Skill>
      </SkillBox>
    </Section>

    <Divider />

    <Section title="Lebenslauf">
      <Timeline>
        <!-- Grundschule -->
        <TimelineEntry date="09/1994 - 07/1998">
          <Link href="https://grundschuledaenischenhagen.de">Grundschule Dänischenhagen</Link>
        </TimelineEntry>
        <!-- Reaschule -->
        <TimelineEntry date="09/1998 - 06/2004">
          <Link href="https://www.gemeinschaftsschule-altenholz.de">Realschule Altenholz</Link>
        </TimelineEntry>
        <!-- Gymnasium -->
        <TimelineEntry date="08/2004 - 06/2007">
          <Link href="https://www.rbz-technik.de/vollzeitschule/berufliches-gymnasium">Berufliches Gymnasium - Fachrichtung Technik</Link>
        </TimelineEntry>
        <!-- Zivildienst -->
        <TimelineEntry date="08/2007 - 04/2008">
          Zivildienst beim <Link href="https://www.paritaet-sh.org">Paritätischen SH</Link>
        </TimelineEntry>
        <!-- Praktikum -->
        <TimelineEntry date="05/2008 - 09/2008">
          Praktikum bei der <Link href="https://www.consist.de">Consist Software Solutions GmbH</Link>
        </TimelineEntry>
        <!-- Studium -->
        <TimelineEntry date="10/2008 - 09/2011">
          Duales Studium zum B.Sc. (Wirtschaftsinformatik) an der <Link href="https://www.wak-sh.de">Wirtschaftsakademie Schleswig-Holstein</Link> in Kooperation
          mit der <Link href="https://www.consist.de">Consist Software Solutions GmbH</Link>
        </TimelineEntry>
        <!-- Bader&Jene -->
        <TimelineEntry date="10/2011 - 03/2014">
          Softwareentwickler bei der <Link href="https://www.askdante.com/ueber-uns">Bader&amp;Jene Software-Ingenieurbüro GmbH</Link>
        </TimelineEntry>
        <!-- freenet -->
        <TimelineEntry date="04/2014 - heute">
          Softwareentwickler bei der <Link href="https://www.freenet.de">freenet DLS GmbH</Link>
        </TimelineEntry>
      </Timeline>
    </Section>

    <Divider />

    <Section>
      <div class="mt-4 flex flex-col justify-between gap-4 sm:flex-row">
        <ContactButton icon="thesvg:github" href="https://github.com/PatrickGotthard">GitHub</ContactButton>
        <ContactButton icon="thesvg:xing" href="https://www.xing.com/profile/Patrick_Gotthard">XING</ContactButton>
        <ContactButton icon="heroicons:user-circle-solid" href="/impressum">Impressum</ContactButton>
        <ContactButton icon="heroicons:finger-print-16-solid" href="/datenschutz">Datenschutz</ContactButton>
      </div>
    </Section>
  </body>
</html>
