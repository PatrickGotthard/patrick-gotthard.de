---
import "../styles/global.css";

import Skill from "../components/Skill.astro";
import SkillBox from "../components/SkillBox.astro";
import ContactButton from "../components/ContactButton.astro";
import Divider from "../components/Divider.astro";
import ExternalLink from "../components/ExternalLink.astro";
import SectionTitle from "../components/SectionTitle.astro";
import TimelineEntry from "../components/TimelineEntry.astro";
---

<html lang="de" class="scroll-smooth">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <title>Patrick Gotthard - Softwareentwickler</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
  </head>
  <body class="min-h-screen overflow-x-hidden bg-slate-50 text-slate-900">
    <main class="mx-auto flex max-w-3xl flex-col justify-center px-6 py-20">
      <!-- Intro -->
      <section class="relative pb-16">
        <h1 class="animate-fade-in-up mt-12 font-['Outfit',sans-serif] text-5xl font-bold tracking-tight sm:text-6xl md:text-7xl">Patrick Gotthard</h1>
        <h2 class="animate-fade-in-up animate-delay-150 mt-4 font-['Outfit',sans-serif] text-2xl font-semibold sm:text-3xl">Softwareentwickler</h2>
        <p class="animate-fade-in-up animate-delay-300 mt-8 leading-8">
          Moin moin! Ich heiße Patrick Gotthard und wurde am 20. Mai 1988 in Kiel geboren. Seit Mitte der 90er beschäftige ich mich mit Computern und habe mir
          im Laufe der Jahre ein umfangreiches Wissen in dem Bereich angeeignet. Mittlerweile liegt mein Schwerpunkt bei der Softwareentwicklung.
        </p>
        <Divider />
      </section>

      <!-- Skills -->
      <section class="relative py-16">
        <SectionTitle title="Skills" />

        <div class="mt-6 space-y-5">
          <!-- Sprachen -->
          <SkillBox title="Sprachen">
            <Skill icon="/icons/skills/java.svg">Java</Skill>
            <Skill icon="/icons/skills/typescript.svg">TypeScript</Skill>
            <Skill icon="/icons/skills/javascript.svg">JavaScript</Skill>
            <Skill icon="/icons/skills/python.svg">Python</Skill>
            <Skill icon="/icons/skills/php.svg">PHP</Skill>
            <Skill icon="/icons/skills/html5.svg">HTML</Skill>
            <Skill icon="/icons/skills/css3.svg">CSS</Skill>
          </SkillBox>

          <!-- Technologien -->
          <SkillBox title="Technologien">
            <Skill icon="/icons/skills/spring.svg">Spring</Skill>
            <Skill icon="/icons/skills/springboot.svg">Spring Boot</Skill>
            <Skill icon="/icons/skills/maven.svg">Maven</Skill>
            <Skill icon="/icons/skills/nodejs.svg">Node.js</Skill>
            <Skill icon="/icons/skills/svelte.svg">Svelte</Skill>
            <Skill icon="/icons/skills/vuejs.svg">Vue.js</Skill>
            <Skill icon="/icons/skills/tailwindcss.svg">Tailwind CSS</Skill>
            <Skill icon="/icons/skills/git.svg">Git</Skill>
            <Skill icon="/icons/skills/docker.svg">Docker</Skill>
          </SkillBox>

          <!-- Datenbanken -->
          <SkillBox title="Datenbanken">
            <Skill icon="/icons/skills/mysql.svg">MySQL</Skill>
            <Skill icon="/icons/skills/mariadb.svg">MariaDB</Skill>
            <Skill icon="/icons/skills/postgresql.svg">PostgreSQL</Skill>
            <Skill icon="/icons/skills/mongodb.svg">MongoDB</Skill>
          </SkillBox>

          <!-- Cloud -->
          <SkillBox title="Cloud">
            <Skill icon="/icons/skills/amazonaws.svg">AWS</Skill>
            <Skill icon="/icons/skills/googlecloud.svg">GCP</Skill>
            <Skill icon="/icons/skills/kubernetes.svg">Kubernetes</Skill>
            <Skill icon="/icons/skills/amazonaws.svg">CDK</Skill>
            <Skill icon="/icons/skills/terraform.svg">Terraform</Skill>
            <Skill icon="/icons/skills/serverless.svg">Serverless Framework</Skill>
          </SkillBox>

          <!-- Tools -->
          <SkillBox title="Tools">
            <Skill icon="/icons/skills/spring.svg">Spring Tool Suite</Skill>
            <Skill icon="/icons/skills/vscode.svg">VSCode</Skill>
            <Skill icon="/icons/skills/notepadplusplus.svg">Notepad++</Skill>
            <Skill icon="/icons/skills/heidisql.ico">HeidiSQL</Skill>
            <Skill icon="/icons/skills/studio3t.svg">Studio 3T</Skill>
            <Skill icon="/icons/skills/datagrip.svg">DataGrip</Skill>
            <Skill icon="/icons/skills/postman.svg">Postman</Skill>
            <Skill icon="/icons/skills/apachejmeter.svg">Apache JMeter</Skill>
            <Skill icon="/icons/skills/putty.svg">PuTTY</Skill>
            <Skill icon="/icons/skills/winscp.ico">WinSCP</Skill>
            <Skill icon="/icons/skills/chrome.svg">Google Chrome</Skill>
          </SkillBox>

          <!-- Betriebssysteme -->
          <SkillBox title="Betriebssysteme">
            <Skill icon="/icons/skills/windows8.svg">Windows</Skill>
            <Skill icon="/icons/skills/linux.svg">Linux</Skill>
            <Skill icon="/icons/skills/apple.svg">macOS</Skill>
          </SkillBox>

          <!-- Sonstiges -->
          <!--
            <SkillBox title="Sonstiges">
              <Skill icon="/icons/skills/fastapi.svg">REST</Skill>
              <Skill icon="/icons/skills/sonarqube.svg">Clean Code</Skill>
              <Skill icon="/icons/skills/git.svg">Git</Skill>
            </SkillBox>
          -->
        </div>
        <Divider />
      </section>

      <!-- Laufbahn -->
      <section class="relative py-16">
        <SectionTitle title="Lebenslauf" />

        <div class="relative mt-8 space-y-8 before:absolute before:top-2 before:bottom-2 before:left-2 before:w-px before:bg-slate-300 sm:before:left-40">
          <!-- Grundschule -->
          <TimelineEntry date="09/1994 - 07/1998">
            <ExternalLink href="https://grundschuledaenischenhagen.de/">Grundschule Dänischenhagen</ExternalLink>
          </TimelineEntry>

          <!-- Realschule -->
          <TimelineEntry date="09/1998 - 06/2004">
            <ExternalLink href="https://www.gemeinschaftsschule-altenholz.de/">Realschule Altenholz</ExternalLink>
          </TimelineEntry>

          <!-- Gymnasium -->
          <TimelineEntry date="08/2004 - 06/2007">
            <ExternalLink href="https://rbz-technik-kiel.geo.io/">Berufliches Gymnasium Fachrichtung Technik</ExternalLink>
          </TimelineEntry>

          <!-- Zivildienst -->
          <TimelineEntry date="08/2007 - 04/2008">
            Zivildienst beim <ExternalLink href="https://www.paritaet-sh.org/">Paritätischen SH</ExternalLink>
          </TimelineEntry>

          <!-- Praktikum -->
          <TimelineEntry date="05/2008 - 09/2008">
            Praktikum bei der <ExternalLink href="https://www.consist.de/">Consist Software Solutions GmbH</ExternalLink>
          </TimelineEntry>

          <!-- Studium  -->
          <TimelineEntry date="10/2008 - 09/2011">
            Duales Studium zum B.Sc. (Wirtschaftsinformatik) an der
            <ExternalLink href="https://www.wak-sh.de/">Wirtschaftsakademie Schleswig-Holstein</ExternalLink>
            in Kooperation mit der
            <ExternalLink href="https://www.consist.de/">Consist Software Solutions GmbH</ExternalLink>
          </TimelineEntry>

          <!-- Bader & Jene -->
          <TimelineEntry date="10/2011 - 03/2014">
            Softwareentwickler bei der <ExternalLink href="https://www.askdante.com/ueber-uns">Bader&amp;Jene Software-Ingenieurbüro GmbH</ExternalLink>
          </TimelineEntry>

          <!-- freenet -->
          <TimelineEntry date="04/2014 - heute">
            Softwareentwickler bei der <ExternalLink href="https://www.freenet-mobilfunk.de/">freenet DLS GmbH</ExternalLink>
          </TimelineEntry>
        </div>
        <Divider />
      </section>

      <!-- Kontakt -->
      <section class="pt-16">
        <SectionTitle title="Kontakt" />
        <div class="mt-6 flex flex-col gap-3 sm:flex-row">
          <ContactButton href="https://github.com/PatrickGotthard" icon="/icons/github.svg" label="GitHub" external />
          <ContactButton href="https://www.xing.com/profile/Patrick_Gotthard" icon="/icons/xing.svg" label="XING" external />
          <ContactButton href="mailto:kontakt@patrick-gotthard.de" icon="/icons/mail.svg" label="E-Mail" />
        </div>
      </section>
    </main>
  </body>
</html>
