---
import Skill from "../components/Skill.astro";
import SkillBox from "../components/SkillBox.astro";
import ContactButton from "../components/ContactButton.astro";
import ExternalLink from "../components/ExternalLink.astro";
import SectionTitle from "../components/SectionTitle.astro";
import TimelineEntry from "../components/TimelineEntry.astro";
import "../styles/global.css";
---

<html lang="de" class="scroll-smooth">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <title>Patrick Gotthard - Softwareentwickler</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@500;600;700;800&family=Source+Sans+3:wght@400;500;600;700&display=swap" rel="stylesheet" />
  </head>
  <body
    class="min-h-screen overflow-x-hidden bg-slate-50 font-['Source_Sans_3',sans-serif] text-slate-900 [&_*:focus-visible]:outline-3 [&_*:focus-visible]:outline-offset-3 [&_*:focus-visible]:outline-[#6f9bc9] [&_h1]:font-['Outfit',sans-serif] [&_h2]:font-['Outfit',sans-serif] [&_h3]:font-['Outfit',sans-serif]"
  >
    <main class="mx-auto flex min-h-screen max-w-3xl flex-col justify-center px-6 py-20">
      <!-- Intro -->
      <section
        class="relative order-1 pb-16 after:absolute after:right-[calc(50%-50vw)] after:bottom-0 after:left-[calc(50%-50vw)] after:h-px after:bg-slate-200"
      >
        <h1 class="mt-12 text-5xl font-bold tracking-tight sm:text-6xl md:text-7xl">Patrick Gotthard</h1>
        <h2 class="mt-4 text-2xl font-semibold text-slate-500 sm:text-3xl">Softwareentwickler</h2>
        <p class="mt-8 max-w-2xl text-lg leading-8 text-slate-600">
          Moin moin! Ich heiße Patrick Gotthard und wurde am 20. Mai 1988 in Kiel geboren. Seit Mitte der 90er beschäftige ich mich mit Computern, angefangen
          mit MS-DOS 6.0, und habe mir im Laufe der Jahre ein umfangreiches Wissen in dem Bereich angeeignet. Mittlerweile liegt mein Schwerpunkt bei der
          Softwareentwicklung.
        </p>
      </section>

      <!-- Skills -->
      <section
        id="skills"
        class="relative order-3 py-16 after:absolute after:right-[calc(50%-50vw)] after:bottom-0 after:left-[calc(50%-50vw)] after:h-px after:bg-slate-200 [&_.skill-badge]:cursor-pointer [&_.skill-badge]:bg-[#e2edf8]! [&_.skill-badge]:text-slate-700! [&_.skill-badge]:no-underline [&_.skill-badge]:transition [&_.skill-badge]:duration-150 [&_.skill-badge:hover]:-translate-y-px [&_.skill-badge:hover]:bg-[#d1e3f4]! [&_.skill-badge:hover]:text-slate-700! [&_.skill-icon]:h-4 [&_.skill-icon]:w-4 [&_.skill-icon]:object-contain [&>div>div]:transition [&>div>div]:duration-200 [&>div>div]:ease-out [&>div>div:hover]:-translate-y-1 [&>div>div:hover]:shadow-[0_12px_28px_rgb(15_23_42/0.1)]"
      >
        <SectionTitle title="Skills" />

        <div class="mt-6 space-y-5">
          <!-- Sprachen -->
          <SkillBox title="Sprachen">
            <Skill icon="/icons/skills/java.svg">Java</Skill>
            <Skill icon="/icons/skills/typescript.svg">TypeScript</Skill>
            <Skill icon="/icons/skills/javascript.svg">JavaScript</Skill>
            <Skill icon="/icons/skills/python.svg">Python</Skill>
            <Skill icon="/icons/skills/php.svg">PHP</Skill>
            <Skill icon="/icons/skills/html5.svg">HTML</Skill>
            <Skill icon="/icons/skills/css3.svg">CSS</Skill>
          </SkillBox>

          <!-- Technologien -->
          <SkillBox title="Technologien">
            <Skill icon="/icons/skills/spring.svg">Spring</Skill>
            <Skill icon="/icons/skills/tailwindcss.svg">Tailwind CSS</Skill>
            <Skill icon="/icons/skills/svelte.svg">Svelte</Skill>
            <Skill icon="/icons/skills/vuejs.svg">Vue.js</Skill>
            <Skill icon="/icons/skills/nodejs.svg">Node.js</Skill>
            <Skill icon="/icons/skills/maven.svg">Maven</Skill>
            <Skill icon="/icons/skills/git.svg">Git</Skill>
            <Skill icon="/icons/skills/springboot.svg">Spring Boot</Skill>
            <Skill icon="/icons/skills/thymeleaf.svg">Thymeleaf</Skill>
            <Skill icon="/icons/skills/docker.svg">Docker</Skill>
          </SkillBox>

          <!-- Datenbanken -->
          <SkillBox title="Datenbanken">
            <Skill icon="/icons/skills/mysql.svg">MySQL</Skill>
            <Skill icon="/icons/skills/mariadb.svg">MariaDB</Skill>
            <Skill icon="/icons/skills/postgresql.svg">PostgreSQL</Skill>
            <Skill icon="/icons/skills/mongodb.svg">MongoDB</Skill>
          </SkillBox>

          <!-- AWS -->
          <SkillBox title="AWS">
            <Skill icon="/icons/skills/serverless.svg">Serverless Framework</Skill>
            <Skill icon="/icons/skills/amazonaws.svg">CDK</Skill>
            <Skill icon="/icons/skills/aws-ecs.svg">ECS</Skill>
            <Skill icon="/icons/skills/aws-sns.svg">SNS</Skill>
            <Skill icon="/icons/skills/aws-sqs.svg">SQS</Skill>
            <Skill icon="/icons/skills/aws-cloudformation.svg">CloudFormation</Skill>
            <Skill icon="/icons/skills/aws-cloudwatch.svg">CloudWatch</Skill>
            <Skill icon="/icons/skills/aws-lambda.svg">Lambda</Skill>
            <Skill icon="/icons/skills/aws-iam.svg">IAM</Skill>
            <Skill icon="/icons/skills/aws-s3.svg">S3</Skill>
          </SkillBox>

          <!-- GCP -->
          <SkillBox title="GCP">
            <Skill icon="/icons/skills/googlecloud.svg">GCP</Skill>
            <Skill icon="/icons/skills/terraform.svg">Terraform</Skill>
          </SkillBox>

          <!-- Kubernetes -->
          <SkillBox title="Kubernetes">
            <Skill icon="/icons/skills/kubernetes.svg">Kubernetes</Skill>
          </SkillBox>

          <!-- Tools -->
          <SkillBox title="Tools">
            <Skill icon="/icons/skills/spring.svg">Spring Tool Suite</Skill>
            <Skill icon="/icons/skills/vscode.svg">VSCode</Skill>
            <Skill icon="/icons/skills/postman.svg">Postman</Skill>
            <Skill icon="/icons/skills/apachejmeter.svg">Apache JMeter</Skill>
            <Skill icon="/icons/skills/chrome.svg">Google Chrome</Skill>
            <Skill icon="/icons/skills/heidisql.ico">HeidiSQL</Skill>
            <Skill icon="/icons/skills/notepadplusplus.svg">Notepad++</Skill>
            <Skill icon="/icons/skills/putty.svg">PuTTY</Skill>
            <Skill icon="/icons/skills/studio3t.svg">Studio 3T</Skill>
            <Skill icon="/icons/skills/datagrip.svg">DataGrip</Skill>
            <Skill icon="/icons/skills/winscp.ico">WinSCP</Skill>
          </SkillBox>

          <!-- Betriebssysteme -->
          <SkillBox title="Betriebssysteme">
            <Skill icon="/icons/skills/windows8.svg">Windows</Skill>
            <Skill icon="/icons/skills/linux.svg">Linux</Skill>
            <Skill icon="/icons/skills/apple.svg">macOS</Skill>
          </SkillBox>

          <!-- Sonstiges -->
          <SkillBox title="Sonstiges">
            <Skill icon="/icons/skills/fastapi.svg">REST</Skill>
            <Skill icon="/icons/skills/sonarqube.svg">Clean Code</Skill>
            <Skill icon="/icons/skills/git.svg">Git</Skill>
          </SkillBox>
        </div>
      </section>

      <!-- Laufbahn -->
      <section
        id="laufbahn"
        class="relative order-4 py-16 after:absolute after:right-[calc(50%-50vw)] after:bottom-0 after:left-[calc(50%-50vw)] after:h-px after:bg-slate-200 [&_a]:text-inherit [&_a]:underline [&_a]:decoration-slate-400 [&_a]:decoration-1 [&_a]:underline-offset-2 [&_a]:transition-colors [&_a:hover]:text-blue-600"
      >
        <SectionTitle title="Laufbahn" />

        <div
          class="relative mt-8 space-y-8 before:absolute before:top-2 before:bottom-2 before:left-2 before:w-px before:bg-slate-300 sm:before:left-40 [&>.timeline-entry]:relative [&>.timeline-entry]:pl-8 [&>.timeline-entry]:before:absolute [&>.timeline-entry]:before:top-[0.35rem] [&>.timeline-entry]:before:left-[0.2rem] [&>.timeline-entry]:before:h-[0.65rem] [&>.timeline-entry]:before:w-[0.65rem] [&>.timeline-entry]:before:rounded-full [&>.timeline-entry]:before:border-2 [&>.timeline-entry]:before:border-[#6f9bc9] [&>.timeline-entry]:before:bg-slate-50 sm:[&>.timeline-entry]:grid sm:[&>.timeline-entry]:grid-cols-[9rem_1fr] sm:[&>.timeline-entry]:gap-8 sm:[&>.timeline-entry]:pl-0 sm:[&>.timeline-entry]:before:left-[9.7rem]"
        >
          <!-- Grundschule -->
          <TimelineEntry date="09/1994 - 07/1998">
            <ExternalLink href="https://grundschuledaenischenhagen.de/">Grundschule Dänischenhagen</ExternalLink>
          </TimelineEntry>

          <!-- Realschule -->
          <TimelineEntry date="09/1998 - 06/2004">
            <ExternalLink href="https://www.gemeinschaftsschule-altenholz.de/">Realschule Altenholz</ExternalLink>
          </TimelineEntry>

          <!-- Gymnasium -->
          <TimelineEntry date="08/2004 - 06/2007">
            <ExternalLink href="https://rbz-technik-kiel.geo.io/">Berufliches Gymnasium Fachrichtung Technik</ExternalLink>
          </TimelineEntry>

          <!-- Zivildienst -->
          <TimelineEntry date="08/2007 - 04/2008">
            Zivildienst beim <ExternalLink href="https://www.paritaet-sh.org/">Paritätischen SH</ExternalLink>
          </TimelineEntry>

          <!-- Praktikum -->
          <TimelineEntry date="05/2008 - 09/2008">
            Praktikum bei der <ExternalLink href="https://www.consist.de/">Consist Software Solutions GmbH</ExternalLink>
          </TimelineEntry>

          <!-- Studium  -->
          <TimelineEntry date="10/2008 - 09/2011">
            Duales Studium zum B.Sc. (Wirtschaftsinformatik) an der
            <ExternalLink href="https://www.wak-sh.de/">Wirtschaftsakademie Schleswig-Holstein</ExternalLink>
            in Kooperation mit der
            <ExternalLink href="https://www.consist.de/">Consist Software Solutions GmbH</ExternalLink>
          </TimelineEntry>

          <!-- Bader & Jene -->
          <TimelineEntry date="10/2011 - 03/2014">
            Softwareentwickler bei der <ExternalLink href="https://www.askdante.com/ueber-uns">Bader&amp;Jene Software-Ingenieurbüro GmbH</ExternalLink>
          </TimelineEntry>

          <!-- freenet -->
          <TimelineEntry date="04/2014 - heute" current>
            Softwareentwickler bei der <ExternalLink href="https://www.freenet-mobilfunk.de/">freenet DLS GmbH</ExternalLink>
          </TimelineEntry>
        </div>
      </section>

      <!-- Kontakt -->
      <section
        id="kontakt"
        class="order-5 pt-16 [&_a]:shadow-[0_10px_22px_rgb(15_23_42/0.16)] [&_a]:transition [&_a]:duration-200 [&_a]:ease-out [&_a:hover]:-translate-y-1 [&_a:hover]:bg-[#6f9bc9] [&_a:hover]:shadow-[0_18px_34px_rgb(15_23_42/0.22)]"
      >
        <SectionTitle title="Kontakt" />
        <div class="mt-6 flex flex-col gap-3 sm:flex-row">
          <ContactButton href="https://github.com/PatrickGotthard" icon="/icons/github.svg" label="GitHub" external />
          <ContactButton href="https://www.xing.com/profile/Patrick_Gotthard" icon="/icons/xing.svg" label="XING" external />
          <ContactButton href="mailto:kontakt@patrick-gotthard.de" icon="/icons/mail.svg" label="E-Mail" />
        </div>
      </section>
    </main>
  </body>
</html>
