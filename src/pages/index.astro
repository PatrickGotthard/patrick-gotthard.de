            <Skill icon="https://cdn.jsdelivr.net/gh/devicons/devicon/icons/maven/maven-original.svg">Maven</Skill>
            <Skill icon="https://cdn.jsdelivr.net/gh/devicons/devicon/icons/git/git-original.svg">Git</Skill>
