      </section>

      <!-- Kontakt -->
      <section
        id="kontakt"
        class="order-5 pt-16 [&_a]:shadow-[0_10px_22px_rgb(15_23_42/0.16)] [&_a]:transition [&_a]:duration-200 [&_a]:ease-out [&_a:hover]:-translate-y-1 [&_a:hover]:bg-[#6f9bc9] [&_a:hover]:shadow-[0_18px_34px_rgb(15_23_42/0.22)]"
      >
        <h2 class="text-sm font-semibold tracking-[0.2em] text-slate-400 uppercase">Kontakt</h2>

        <div class="mt-6 flex flex-col gap-3 sm:flex-row">
          <!-- GitHub -->
          <ContactButton href="https://github.com/PatrickGotthard" label="GitHub" external>
            <svg slot="icon" class="h-5 w-5" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path
                d="M12 .5C5.65.5.5 5.65.5 12c0 5.09 3.29 9.4 7.86 10.93.58.11.79-.25.79-.56v-2.16c-3.2.7-3.88-1.36-3.88-1.36-.53-1.33-1.28-1.68-1.28-1.68-1.04-.71.08-.7.08-.7 1.15.08 1.76 1.18 1.76 1.18 1.02 1.75 2.68 1.25 3.33.96.1-.74.4-1.25.73-1.54-2.55-.29-5.23-1.28-5.23-5.69 0-1.26.45-2.29 1.18-3.1-.12-.29-.51-1.47.11-3.06 0 0 .96-.31 3.15 1.18a10.9 10.9 0 0 1 5.74 0c2.19-1.49 3.15-1.18 3.15-1.18.62 1.59.23 2.77.11 3.06.73.81 1.18 1.84 1.18 3.1 0 4.42-2.69 5.39-5.25 5.68.41.36.78 1.07.78 2.16v3.2c0 .31.21.67.8.56A11.51 11.51 0 0 0 23.5 12C23.5 5.65 18.35.5 12 .5Z"
              ></path>
            </svg>
          </ContactButton>

          <!-- XING -->
          <ContactButton href="https://www.xing.com/profile/Patrick_Gotthard" label="XING" external>
            <svg slot="icon" class="h-5 w-5" viewBox="0 0 512 512" fill="currentColor" aria-hidden="true">
              <path
                style="display: inline; fill-rule: evenodd; clip-rule: evenodd"
                d="M309.215,304.749 c30.414,57.874,62.227,114.961,94.801,173.782c4.402,7.997,11.826,19.137,8.67,26.073c-4.242,9.332-25.275,5.539-41.855,5.539 c-19.523,0-36.902,3.53-49.764-0.799c-13.125-4.416-25.002-36.989-31.6-48.979c-27.934-50.773-57.736-105.254-85.319-154.831 c47.294-86.353,103.108-180.979,152.448-270.165c7.572-13.661,13.748-33.771,31.613-34.769C396.68,0.14,413.596,1.4,430.875,1.4 c14.32,0,36.428-2.108,40.295,3.941c6.6,10.367-10.842,30.466-15.807,39.51C407.158,132.44,356.971,217.997,309.215,304.749z M125.953,357.67c15.657-1.908,23.653-23.777,30.789-36.341c22.631-39.746,45.697-80.715,66.369-117.705 c-12.774-23.728-29.766-51.385-44.249-76.624c-6.25-10.891-10.979-25.087-25.263-25.275c-25.275,0-50.575,0-75.85,0 c-4.129,0.586-7.846,1.635-8.682,5.527c-2.046,12.438,5.625,19.486,9.48,26.073c8.97,15.407,17.978,29.866,27.646,46.608 c3.094,5.327,12.874,18.938,12.625,24.489c-0.15,3.718-7.598,12.638-10.254,17.378c-21.607,38.586-39.334,70.735-60.83,109.009 c-3.194,5.689-10.267,12.301-7.896,20.534c1.023,3.605,6.749,6.637,9.469,6.325C74.853,357.67,100.403,357.67,125.953,357.67z"
              ></path>
            </svg>
          </ContactButton>

          <!-- E-Mail -->
          <ContactButton href="mailto:kontakt@patrick-gotthard.de" label="E-Mail">
            <svg slot="icon" class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <rect x="3" y="5" width="18" height="14" rx="2"></rect>
