---
import "../styles/global.css";
---

<html lang="de">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <title>Astro</title><link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@500;600;700;800&family=Source+Sans+3:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <script src="https://unpkg.com/lucide@latest"></script>
    <style>
      html {
        scroll-behavior: smooth;
      }

      body {
        font-family: "Source Sans 3", sans-serif;
        overflow-x: hidden;
      }

      h1,
      h2,
      h3 {
        font-family: "Outfit", sans-serif;
      }

      :root {
        --accent: rgb(111 155 201);
        --accent-dark: rgb(69 111 156);
        --accent-soft: rgb(226 237 248);
        --accent-hover: rgb(209 227 244);
      }

      .skill-icon {
        width: 1rem;
        height: 1rem;
        object-fit: contain;
      }

      #skills > div > div {
        transition:
          box-shadow 200ms ease,
          transform 200ms ease,
          border-color 200ms ease;
      }

      #skills > div > div:hover {
        transform: translateY(-4px);
        box-shadow: 0 12px 28px rgb(15 23 42 / 0.1);
      }

      .skill-badge.skill-badge {
        background: var(--accent-soft);
        color: rgb(51 65 85);
        cursor: pointer;
        text-decoration: none;
        transition:
          background-color 160ms ease,
          color 160ms ease,
          transform 160ms ease;
      }

      .skill-badge.skill-badge:hover {
        transform: translateY(-1px);
        background: var(--accent-hover);
        color: rgb(51 65 85);
      }

      #laufbahn a {
        color: inherit;
        text-decoration: underline;
        text-decoration-color: rgb(148 163 184);
        text-decoration-thickness: 1px;
        text-underline-offset: 2px;
        transition: color 160ms ease;
      }

      #laufbahn a:hover {
        color: var(--accent-dark);
      }

      #kontakt a {
        box-shadow: 0 10px 22px rgb(15 23 42 / 0.16);
        transition:
          background-color 200ms ease,
          box-shadow 200ms ease,
          transform 200ms ease;
      }

      #kontakt a:hover {
        transform: translateY(-5px);
        background: var(--accent);
        box-shadow: 0 18px 34px rgb(15 23 42 / 0.22);
      }

      a:focus-visible {
        outline: 3px solid var(--accent);
        outline-offset: 3px;
      }

      .fade-up {
        animation: fade-up 0.7s ease-out forwards;
        opacity: 0;
      }

      .fade-up-delay-1 {
        animation-delay: 0.15s;
      }

      .fade-up-delay-2 {
        animation-delay: 0.3s;
      }

      .fade-up-delay-3 {
        animation-delay: 0.45s;
      }

      .full-width-divider {
        position: relative;
      }

      .full-width-divider::after {
        position: absolute;
        right: calc(50% - 50vw);
        bottom: 0;
        left: calc(50% - 50vw);
        height: 1px;
        background: rgb(226 232 240);
        content: "";
      }

      .timeline {
        position: relative;
      }

      .timeline::before {
        position: absolute;
        top: 0.5rem;
        bottom: 0.5rem;
        left: 0.5rem;
        width: 1px;
        background: rgb(203 213 225);
        content: "";
      }

      .timeline-entry {
        position: relative;
        padding-left: 2rem;
      }

      .timeline-entry::before {
        position: absolute;
        top: 0.35rem;
        left: 0.2rem;
        width: 0.65rem;
        height: 0.65rem;
        border: 2px solid rgb(111 155 201);
        border-radius: 999px;
        background: rgb(248 250 252);
        content: "";
      }

      @media (min-width: 640px) {
        .timeline::before {
          left: 10rem;
        }

        .timeline-entry {
          display: grid;
          grid-template-columns: 9rem 1fr;
          gap: 2rem;
          padding-left: 0;
        }

        .timeline-entry::before {
          left: calc(10rem - 0.3rem);
        }
      }

      @keyframes fade-up {
        0% {
          opacity: 0;
          transform: translateY(20px);
        }

        100% {
          opacity: 1;
          transform: translateY(0);
        }
      }

      @media (prefers-reduced-motion: reduce) {
        .fade-up {
          animation: none;
          opacity: 1;
        }
      }
    </style>
  </head>

