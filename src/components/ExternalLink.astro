---
interface Props {
  href: string;
}

const { href } = Astro.props;
---

<a
  href={href}
  target="_blank"
  rel="noopener noreferrer"
  class="text-inherit underline decoration-slate-400 decoration-1 underline-offset-2 transition-colors hover:text-blue-600 focus-visible:outline-3 focus-visible:outline-offset-3 focus-visible:outline-blue-400"
>
  <slot />
</a>
