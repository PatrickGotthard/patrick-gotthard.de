---
interface Props {
  date: string;
}

const { date } = Astro.props;
---

<div class="relative pl-8 sm:grid sm:grid-cols-[9rem_1fr] sm:gap-8 sm:pl-0">
  <span class="absolute top-1.5 left-2 size-2.5 -translate-x-1/2 rounded-full border-2 border-blue-400 bg-slate-50 sm:left-40"></span>
  <p class="text-sm font-medium">{date}</p>
  <p class="text-sm font-medium">
    <slot />
  </p>
</div>
