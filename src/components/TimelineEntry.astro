---
interface Props {
  date: string;
  current?: boolean;
}

const { date, current = false } = Astro.props;
---

<div
  class:list={[
    "timeline-entry relative pl-8 before:absolute before:top-1.5 before:left-2 before:h-2.5 before:w-2.5 before:-translate-x-1/2 before:rounded-full before:border-2 before:border-blue-400 before:bg-slate-50 sm:grid sm:grid-cols-[9rem_1fr] sm:gap-8 sm:pl-0 sm:before:left-40",
    current && "before:bg-blue-400!"
  ]}
>
  <p class="text-sm font-semibold text-slate-500">{date}</p>
  <p class="font-semibold text-slate-900">
    <slot />
  </p>
</div>
