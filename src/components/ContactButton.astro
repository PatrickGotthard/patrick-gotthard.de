---
interface Props {
  href: string;
  icon: string;
  label: string;
  external?: boolean;
}

const { href, icon, label, external = false } = Astro.props;
---

<a
  href={href}
  target={external ? "_blank" : undefined}
  rel={external ? "noopener noreferrer" : undefined}
  class="inline-flex items-center justify-center gap-3 rounded-lg bg-slate-900 px-5 py-3 font-medium text-white shadow-[0_10px_22px_rgb(15_23_42/0.16)] transition duration-200 ease-out hover:-translate-y-1 hover:bg-[#6f9bc9] hover:shadow-[0_18px_34px_rgb(15_23_42/0.22)] focus-visible:outline-3 focus-visible:outline-offset-3 focus-visible:outline-[#6f9bc9]"
>
  <img class="h-5 w-5" src={icon} alt="" />
  {label}
</a>
