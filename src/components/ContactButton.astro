---
interface Props {
  href: string;
  icon: string;
  label: string;
  external?: boolean;
}

const { href, icon, label, external = false } = Astro.props;
---

<a
  href={href}
  target={external ? "_blank" : undefined}
  rel={external ? "noopener noreferrer" : undefined}
  class="inline-flex items-center justify-center gap-3 rounded-lg bg-slate-900 px-5 py-3 font-medium text-white shadow-lg transition duration-200 ease-out hover:-translate-y-1 hover:bg-blue-400 hover:shadow-2xl focus-visible:outline-3 focus-visible:outline-offset-3 focus-visible:outline-blue-400"
>
  <img class="h-5 w-5" src={icon} alt="" />
  {label}
</a>
