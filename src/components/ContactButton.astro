---
interface Props {
  href: string;
  icon: string;
  label: string;
  external?: boolean;
}

const { href, icon, label, external = false } = Astro.props;
---

<a
  href={href}
  target={external ? "_blank" : undefined}
  rel={external ? "noopener noreferrer" : undefined}
  class="inline-flex items-center justify-center gap-3 rounded-lg bg-slate-900 px-5 py-3 font-medium text-white transition hover:bg-blue-600"
>
  <img class="h-5 w-5" src={icon} alt="" />
  {label}
</a>
