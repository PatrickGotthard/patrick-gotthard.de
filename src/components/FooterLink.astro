---
import { Icon } from "astro-icon/components";

interface Props {
  icon: string;
  href: string;
}

const { icon, href } = Astro.props;
---

<a href={href} class="inline-flex items-center justify-center gap-2 text-sm font-medium transition hover:text-blue-400">
  <Icon class="size-5" name={icon} />
  <slot />
</a>
