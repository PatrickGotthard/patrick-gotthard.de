---
interface Props {
  icon: string;
}

const { icon } = Astro.props;
---

<span
  class="skill-badge inline-flex cursor-pointer items-center gap-1.5 rounded-md bg-[#e2edf8] px-3 py-1.5 text-sm font-medium text-slate-700 no-underline transition duration-150 hover:-translate-y-px hover:bg-[#d1e3f4] hover:text-slate-700 focus-visible:outline-3 focus-visible:outline-offset-3 focus-visible:outline-[#6f9bc9]"
>
  <img class="skill-icon h-4 w-4 object-contain" src={icon} alt="" />
  <slot />
</span>
