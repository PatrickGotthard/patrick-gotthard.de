---
import { Icon } from "astro-icon/components";

interface Props {
  icon: string;
  href?: string;
}

const { icon, href } = Astro.props;
---

<a class="inline-flex items-center gap-1.5 rounded bg-blue-50 px-3 py-1.5 text-sm font-medium transition hover:-translate-y-px hover:bg-blue-100" href={href}>
  <Icon class="size-4" name={icon} />
  <slot />
</a>
