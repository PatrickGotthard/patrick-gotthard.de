---
interface Props {
  title: string;
}

const { title } = Astro.props;
---

<div class="mt-5 rounded-xl border border-slate-200 bg-white p-5 shadow-sm transition hover:-translate-y-1 hover:shadow-md">
  <div class="flex flex-col gap-2 sm:flex-row">
    <h3 class="w-36 shrink-0 font-medium">{title}</h3>
    <div class="flex flex-wrap gap-2">
      <slot />
    </div>
  </div>
</div>
