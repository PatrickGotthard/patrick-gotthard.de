---
interface Props {
  title: string;
}

const { title } = Astro.props;
---

<div class="rounded-xl bg-white p-5 shadow-sm ring-1 ring-slate-200 transition duration-200 ease-out hover:-translate-y-1 hover:shadow-lg">
  <div class="flex flex-col gap-3 sm:flex-row sm:items-center">
    <h3 class="w-36 shrink-0 font-semibold text-slate-900">{title}</h3>

    <div class="flex flex-wrap gap-2">
      <slot />
    </div>
  </div>
</div>
